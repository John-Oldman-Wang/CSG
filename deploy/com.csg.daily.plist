<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.csg.daily</string>

  <!-- 直接调项目自己的 venv python，不经 /bin/bash。
       仓库在 ~/Documents 下受 macOS TCC 保护，launchd 进程默认无访问权
       （2026-08-16 首次触发即 exit 126）。走 bash 意味着必须给 /bin/bash
       授予完全磁盘访问权限，此后**任何** bash 脚本都获得该权限；
       走本 venv 则只需给这一个项目专属解释器授权，爆炸半径仅限本项目。
       看门狗本就调它，一次授权覆盖两个任务。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/wwww/Documents/GitHub/CSG/.venv/bin/python</string>
    <string>-u</string>
    <string>-m</string>
    <string>csg.cli</string>
    <string>daily</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TQDM_DISABLE</key><string>1</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/wwww/Documents/GitHub/CSG</string>

  <!-- 一天两次：
       07:30 抓昨夜披露的年报/季报（A股财报多在盘后与夜间公告）
       19:30 抓当日盘后研报与行情
       休眠错过的那次，launchd 会在唤醒后补跑一次（cron 会直接跳过） -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/wwww/Documents/GitHub/CSG/logs/launchd_daily.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/wwww/Documents/GitHub/CSG/logs/launchd_daily.err</string>

  <!-- 采集是长任务且会独占 DuckDB 写锁，不能与自己并发 -->
  <key>AbandonProcessGroup</key><false/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
